import cv2
import numpy as np
import serial

ser = serial.Serial('COM9', 115200, timeout=1)


cap = cv2.VideoCapture(1, cv2.CAP_DSHOW)  # CAP_DSHOW for fast connection
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
cap.set(cv2.CAP_PROP_FPS, 60)

STOP_X = 150  # Goalie X-coordinate
TOP_WALL_Y = 40  # Top boundary (pixel Y)
BOTTOM_WALL_Y = 365  # Bottom boundary (pixel Y)

COR = 0.62
MIN_VELOCITY = 3
STEP_THRESHOLD = 5

# for black ball
lower_ball = np.array([0, 0, 0], dtype=np.uint8)
upper_ball = np.array([180, 77, 63], dtype=np.uint8)

# Calculate center for motor math
MID_Y = (TOP_WALL_Y + BOTTOM_WALL_Y) / 2
PIXELS_TO_METERS = 0.3 / (BOTTOM_WALL_Y - TOP_WALL_Y)

prev_x, prev_y = None, None
last_sent_step = None

MAX_STEPS = 74
MOTORS_TO_ROD_DIST = 0.05  # Updated to 0.05 meters (5 cm)

# Calculate center for motor math
MID_Y = (TOP_WALL_Y + BOTTOM_WALL_Y) / 2
PIXELS_TO_METERS = 0.3 / (BOTTOM_WALL_Y - TOP_WALL_Y)

# Pre-calculate the maximum angle the arm reaches when the ball is at the wall
MAX_OFFSET_PIXELS = (BOTTOM_WALL_Y - TOP_WALL_Y) / 2.0
MAX_OFFSET_METERS = MAX_OFFSET_PIXELS * PIXELS_TO_METERS
MAX_ANGLE_DEGREES = np.degrees(np.arctan(MAX_OFFSET_METERS / MOTORS_TO_ROD_DIST))


def calculate_steps(y_final):
    """Converts pixel Y to motor steps using exact rotary wiper kinematics."""
    offset_pixels = y_final - MID_Y
    offset_meters = offset_pixels * PIXELS_TO_METERS

    # Calculate true angle required for the arm using Trig
    theta_degrees = np.degrees(np.arctan(offset_meters / MOTORS_TO_ROD_DIST))

    # Scale the angle to your actual hardware steps limit (-74 to +74)
    exact_steps = (theta_degrees / MAX_ANGLE_DEGREES) * MAX_STEPS

    return int(round(exact_steps))


while True:
    ret, frame = cap.read()
    if not ret: break

    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
    mask = cv2.inRange(hsv, lower_ball, upper_ball)

    roi_mask = np.zeros_like(mask)

    roi_mask[TOP_WALL_Y - 10: BOTTOM_WALL_Y+10, :] = 255

    mask = cv2.bitwise_and(mask, roi_mask)

    kernel = np.ones((5, 5), np.uint8)
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)

    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    contours = sorted(contours, key=cv2.contourArea, reverse=True)

    ball_center = None
    for cnt in contours:
        area = cv2.contourArea(cnt)
        perimeter = cv2.arcLength(cnt, True)
        if perimeter > 0:
            circularity = 4 * np.pi * (area / (perimeter * perimeter))
            if 50 < area < 2000 and circularity > 0.62:
                (x, y), radius = cv2.minEnclosingCircle(cnt)
                ball_center = (int(x), int(y))
                cv2.circle(frame, ball_center, int(radius), (0, 255, 0), 2)
                break

    if ball_center:
        cur_x, cur_y = ball_center

        if prev_x is not None:
            dx = cur_x - prev_x
            dy = cur_y - prev_y
            velocity = np.sqrt(dx ** 2 + dy ** 2)

            # Only predict if moving towards goalie (dx < 0)
            if dx < -MIN_VELOCITY:
                # Simulation variables
                sim_x, sim_y = float(cur_x), float(cur_y)
                sim_dx, sim_dy = float(dx), float(dy)

                path_points = [(int(sim_x), int(sim_y))]
                max_bounces = 4  # Safety break

                while sim_x > STOP_X and max_bounces > 0:
                    # Time to reach goalie line
                    t_goalie = (STOP_X - sim_x) / sim_dx

                    # Time to reach nearest wall
                    if sim_dy < 0:  # Moving Up
                        t_wall = (TOP_WALL_Y - sim_y) / sim_dy
                    elif sim_dy > 0:  # Moving Down
                        t_wall = (BOTTOM_WALL_Y - sim_y) / sim_dy
                    else:
                        t_wall = float('inf')

                    if t_wall < t_goalie:
                        # HITS WALL FIRST
                        sim_x += sim_dx * t_wall
                        sim_y += sim_dy * t_wall

                        # Apply Bounce
                        sim_dy = -sim_dy * COR

                        path_points.append((int(sim_x), int(sim_y)))
                        max_bounces -= 1
                    else:
                        # HITS GOALIE LINE FIRST
                        sim_y += sim_dy * t_goalie
                        sim_x = STOP_X
                        path_points.append((int(sim_x), int(sim_y)))
                        break

                y_final = np.clip(sim_y, TOP_WALL_Y, BOTTOM_WALL_Y)

                step = calculate_steps(y_final)
                step = max(-70, min(70, step))  # Physical limit safety

                if last_sent_step is None or abs(step - last_sent_step) >= STEP_THRESHOLD:
                    ser.write(f"M2 {-1 * step}\n".encode())
                    print('M2 ', -1 * step)
                    last_sent_step = step

                # Draw Visuals
                for i in range(len(path_points) - 1):
                    cv2.line(frame, path_points[i], path_points[i + 1], (255, 0, 0), 2)
                cv2.circle(frame, (int(STOP_X), int(y_final)), 8, (255, 255, 0), -1)

        prev_x, prev_y = cur_x, cur_y
    else:
        # Reset tracking if ball is lost
        prev_x, prev_y = None, None

    # Wall lines
    cv2.line(frame, (0, int(TOP_WALL_Y)), (640, int(TOP_WALL_Y)), (0, 255, 255), 2)
    cv2.line(frame, (0, int(BOTTOM_WALL_Y)), (640, int(BOTTOM_WALL_Y)), (0, 255, 255), 2)
    # Goalie line
    cv2.line(frame, (STOP_X, 0), (STOP_X, 480), (0, 165, 255), 2)

    cv2.imshow("Non-Elastic Predictor", frame)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
